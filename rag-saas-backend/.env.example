# Copy to .env. Never commit actual credentials.
GROQ_API_KEY=
# Select a model available to your Groq account. This model was verified on 2026-08-31.
# The code's historical llama-3.1-8b-instant default returned HTTP 404 for this account.
GROQ_MODEL=openai/gpt-oss-20b

# Choose cloud mode (QDRANT_PATH empty) or embedded local mode (non-empty path).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=my_documents
QDRANT_PATH=./qdrant_db

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Prefix chunks with a readable file label when reranking (helps name-based questions).
RERANKER_SOURCE_HEADERS=true

# Defaults used by the existing pipeline; no tuning was performed.
EMBEDDING_DIMENSION=384
RETRIEVER_K=40
RETRIEVER_FETCH_K=60
RERANKER_TOP_N=8
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# Optional for public HuggingFace model downloads. Once cached, HF_HUB_OFFLINE=1
# can be set in the shell. Backend embeddings currently hardcode all-MiniLM-L6-v2.
# HF_TOKEN=
